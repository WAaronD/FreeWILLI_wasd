{
    "network": {
        "ipAddress": "127.0.0.1",
        "port": 1045
    },
    "global": {
        "enableIntegrationTesting": true,
        "verbose": false,
        "firmware": "1240",
        "logDirectory": "deployment_files/"
    },
    "pipeline": {
        "steps": [
            {
                "type": "addTimeDomainDetection",
                "params": {
                    "detector": "AbsPeakAmplitude",
                    "threshold": 200
                }
            },
            {
                "type": "addTimeDomainFilter",
                "params": {
                    "filter": "FIRFilter",
                    "filterWeightsFile": "filters/highpass_taps@101_cutoff@15k_window@hamming_fs@100k.txt"
                }
            },
            {
                "type": "addPeakExtraction",
                "params": {
                    "numBefore": 87,
                    "numAfter": 88
                }
            },
            {
                "type": "addONNXClassification",
                "params": {
                    "modelPath": "ML_models/v4/click_classifier.onnx",
                    "normalizationParams": "ML_models/v4/scaler_params.json",
                    "classLabels": ["zc", "wbat", "delphinid", "gg", "noise"]
                }
            },
            {
                "type": "setFileOutput",
                "params": {
                    "directory": "${global.logDirectory}",
                    "integrationTesting": "${global.enableIntegrationTesting}"
                }
            },
            {
                "type": "setNetworkOutput",
                "params": {
                    "host": "127.0.0.1",
                    "port": 55001
                }
            },
            {
                "type": "setConsoleOutput",
                "params": {
                    "enabled": "${global.verbose}"
                }
            },
            {
                "type": "setErrorHandler",
                "params": {
                    "logFile": "${global.logDirectory}error.log"
                }
            }
        ]
    }
}
